<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>625360c2-7a89-4f91-8a19-abb8ad6c9c4e</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..</DockerfileContext>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Marten" Version="9.12.0" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageReference Include="RestSharp" Version="114.0.0" />
    <PackageReference Include="Throw" Version="1.4.0" />
    <PackageReference Include="WolverineFx.Http.FluentValidation" Version="6.16.0" />
    <PackageReference Include="WolverineFx.Http.Marten" Version="6.16.0" />
    <PackageReference Include="WolverineFx.RabbitMQ" Version="6.16.0" />
  </ItemGroup>

</Project>
