@using Home.Automation.WebClient.Services

<BbCard class="w-fit">
    <BbCardHeader>
        <BbCardTitle>@SensorView.Name</BbCardTitle>
        @*  <BbCardDescription>TODO: add ping date</BbCardDescription> *@
    </BbCardHeader>

    <BbCardContent class="p-2 w-fit">
        <BbCard class="">
            <BbCardHeader>
                <BbCardTitle>Humidity statistics</BbCardTitle>
            </BbCardHeader>
            <div class="w-full max-w-5xl grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 p-2">

                <BbCard>
                    <BbCardContent>
                        <div class="flex SensorViews-center justify-between">
                            <p class="text-sm font-medium text-muted-foreground">Current humidity</p>
                        </div>
                        <div class="mt-2">
                            @if (SensorView.Current is null)
                            {
                                <h2 class="text-2xl font-bold">N/A</h2>
                            }
                            else
                            {
                                <h2 class="text-2xl font-bold">@SensorView.Current.Humidity%</h2>
                            }
                        </div>
                    </BbCardContent>
                </BbCard>

                <BbCard>
                    <BbCardContent>
                        <div class="flex SensorViews-center justify-between">
                            <p class="text-sm font-medium text-muted-foreground">Avarage humidity</p>
                        </div>
                        <div class="mt-2">
                            @if (SensorView.Current is null)
                            {
                                <h2 class="text-2xl font-bold">N/A</h2>
                            }
                            else
                            {
                                <h2 class="text-2xl font-bold">@SensorView.TodayHumidity.Average.ToString("0.##")%</h2>
                            }
                        </div>
                    </BbCardContent>
                </BbCard>

                <BbCard>
                    <BbCardContent>
                        <div class="flex SensorViews-center justify-between">
                            <p class="text-sm font-medium text-muted-foreground">Minimum humidity</p>
                        </div>
                        <div class="mt-2">
                            @if (SensorView.Current is null)
                            {
                                <h2 class="text-2xl font-bold">N/A</h2>
                            }
                            else
                            {
                                <h2 class="text-2xl font-bold">@SensorView.TodayHumidity.Min%</h2>
                            }
                        </div>
                    </BbCardContent>
                </BbCard>

                <BbCard>
                    <BbCardContent>
                        <div class="flex SensorViews-center justify-between">
                            <p class="text-sm font-medium text-muted-foreground">Maximum humidity</p>
                        </div>
                        <div class="mt-2">
                            @if (SensorView.Current is null)
                            {
                                <h2 class="text-2xl font-bold">N/A</h2>
                            }
                            else
                            {
                                <h2 class="text-2xl font-bold">@SensorView.TodayHumidity.Max%</h2>
                            }
                        </div>
                    </BbCardContent>
                </BbCard>
            </div>
        </BbCard>

        <BbCard class="mt-2">
            <BbCardHeader>
                <BbCardTitle>Temperature statistics</BbCardTitle>
            </BbCardHeader>
            <div class="w-full max-w-5xl grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 p-2">
                <BbCard>
                    <BbCardContent>
                        <div class="flex SensorViews-center justify-between">
                            <p class="text-sm font-medium text-muted-foreground">Current temperature</p>
                        </div>
                        <div class="mt-2">
                            @if (SensorView.Current is null)
                            {
                                <h2 class="text-2xl font-bold">N/A</h2>
                            }
                            else
                            {
                                <h2 class="text-2xl font-bold">@SensorView.Current.Temperature&deg;C</h2>
                            }
                        </div>
                    </BbCardContent>
                </BbCard>

                <BbCard>
                    <BbCardContent>
                        <div class="flex SensorViews-center justify-between">
                            <p class="text-sm font-medium text-muted-foreground">Average temperature</p>
                        </div>
                        <div class="mt-2">
                            @if (SensorView.Current is null)
                            {
                                <h2 class="text-2xl font-bold">N/A</h2>
                            }
                            else
                            {
                                <h2 class="text-2xl font-bold">@SensorView.TodayTemperature.Average.ToString("0.##")&deg;C</h2>
                            }
                        </div>
                    </BbCardContent>
                </BbCard>

                <BbCard>
                    <BbCardContent>
                        <div class="flex SensorViews-center justify-between">
                            <p class="text-sm font-medium text-muted-foreground">Minimum temperature</p>
                        </div>
                        <div class="mt-2">
                            @if (SensorView.Current is null)
                            {
                                <h2 class="text-2xl font-bold">N/A</h2>
                            }
                            else
                            {
                                <h2 class="text-2xl font-bold">@SensorView.TodayTemperature.Min&deg;C</h2>
                            }
                        </div>
                    </BbCardContent>
                </BbCard>

                <BbCard>
                    <BbCardContent>
                        <div class="flex SensorViews-center justify-between">
                            <p class="text-sm font-medium text-muted-foreground">Maximum temperature</p>
                        </div>
                        <div class="mt-2">
                            @if (SensorView.Current is null)
                            {
                                <h2 class="text-2xl font-bold">N/A</h2>
                            }
                            else
                            {
                                <h2 class="text-2xl font-bold">@SensorView.TodayTemperature.Max%</h2>
                            }
                        </div>
                    </BbCardContent>
                </BbCard>
            </div>
        </BbCard>
    </BbCardContent>
</BbCard>

@code {
	[Parameter, EditorRequired]
	public TemperatureAndHumiditySensorView SensorView { get; set; }
}
